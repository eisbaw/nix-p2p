# Rust build output. Cargo.lock is deliberately NOT ignored: crane needs a
# committed lockfile to build reproducibly.
/target/
**/*.rs.bk

# Nix build results
/result
/result-*
.direnv/

# Local state written by the backlog CLI, not project content. Left untracked
# it makes every `nix build` warn about a dirty git tree.
/backlog/email-preferences.json

# Bytecode for the gate scripts. The dev shell also sets
# PYTHONDONTWRITEBYTECODE, so this is the belt to that pair of braces.
__pycache__/

# Generated fixture cache: NAR payloads (up to 110 MiB), narinfos, and the
# derived test signing key. Deliberately not committed - determinism plus
# pinning to flake.lock is what makes the workload reproducible, so the bytes
# are an output, not an input. `just fixtures` recreates them. Holds the
# immutable generations and the `current` symlink that publishes one of them.
/fixtures/out/
# The publication flock, taken beside the root it serialises.
/fixtures/.out.*

